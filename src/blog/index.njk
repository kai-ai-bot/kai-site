---
layout: layouts/base.njk
title: "Blog"
description: "kai のブログ記事一覧 — microCMS から取得しています"
---

<header class="max-w-5xl mx-auto px-6 pt-24 pb-10">
  <a class="link" href="/">← ホームに戻る</a>
  <h1 class="page-title mt-6">// Blog</h1>
</header>

<main class="max-w-5xl mx-auto px-6 pb-16">
  {% if blogs | length > 0 %}
  <div class="grid gap-6 md:grid-cols-2">
    {% for post in blogs %}
    <a href="/blog/articles/{{ post.id }}/" class="card glow-card p-8 flex flex-col no-underline">
      <div class="font-mono text-xs text-gray-500">{{ post.publishedAt | formatDate }}</div>
      <h2 class="font-mono text-lg text-fg mt-3 leading-snug">{{ post.title }}</h2>
      {% if post.eyecatch %}
      <img
        src="{{ post.eyecatch.url }}"
        alt="{{ post.title }}"
        class="mt-5 rounded-lg border border-border w-full object-cover"
        loading="lazy"
        decoding="async"
      >
      {% endif %}
      {% if post.content %}
      <p class="mt-4 text-sm leading-relaxed text-fg-dim">{{ post.content | excerpt(100) }}</p>
      {% endif %}
    </a>
    {% endfor %}
  </div>
  {% else %}
  <p class="font-mono text-sm text-gray-500">記事はまだありません。</p>
  {% endif %}
</main>

{% include "partials/footer.njk" %}
