---
layout: layouts/base.njk
tags: blog
eleventyComputed:
  title: "{{ post.title }}"
  description: "{{ post.content | excerpt(120) }}"
pagination:
  data: blogs
  size: 1
  alias: post
permalink: "blog/articles/{{ post.id }}/index.html"
---

<header class="max-w-3xl mx-auto px-6 pt-24 pb-10">
  <div class="mt-8 font-mono text-xs text-gray-500">{{ post.publishedAt | formatDate }}</div>
  <h1 class="mt-3 font-mono text-2xl sm:text-4xl font-bold leading-snug text-fg">{{ post.title }}</h1>
  {% if post.eyecatch %}
  <img
    src="{{ post.eyecatch.url }}"
    alt="{{ post.title }}"
    class="mt-8 rounded-xl border border-border w-full object-cover"
    decoding="async"
  >
  {% endif %}
</header>

<main class="max-w-3xl mx-auto px-6 pb-16">
  <article class="blog-body">{{ post.content | safe }}</article>
  <a class="link inline-block mt-12" href="/blog/">← 記事一覧に戻る</a>
</main>

{% include "partials/footer.njk" %}
